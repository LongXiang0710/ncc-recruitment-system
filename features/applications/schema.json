{
  "title": "校园招聘应聘登记",
  "short": "应聘登记",
  "description": "完善应聘资料，记录初筛与面试安排",
  "fields": [
    {
      "key": "archive_no",
      "label": "档案编号",
      "readonly": true
    },
    {
      "key": "candidate_id",
      "label": "关联人才档案",
      "ref": "candidates",
      "hidden": true
    },
    {
      "key": "name",
      "label": "姓名",
      "required": true,
      "section": "基本信息"
    },
    {
      "key": "school_name",
      "label": "毕业院校",
      "required": true
    },
    {
      "key": "screening",
      "label": "初筛情况",
      "options": [
        "合格",
        "不合格"
      ]
    },
    {
      "key": "needs_first_interview",
      "label": "是否需要一面",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "major",
      "label": "专业"
    },
    {
      "key": "gender",
      "label": "性别",
      "options": [
        "男",
        "女",
        "不便透露"
      ]
    },
    {
      "key": "ethnicity",
      "label": "民族"
    },
    {
      "key": "hometown",
      "label": "籍贯"
    },
    {
      "key": "birthdate",
      "label": "出生日期",
      "type": "month"
    },
    {
      "key": "phone",
      "label": "联系电话",
      "type": "tel"
    },
    {
      "key": "email",
      "label": "电子邮箱",
      "type": "email"
    },
    {
      "key": "education",
      "label": "学历",
      "options": [
        "专科",
        "本科",
        "硕士",
        "博士"
      ],
      "section": "教育与语言能力"
    },
    {
      "key": "enrollment_type",
      "label": "入学形式",
      "options": [
        "普通全日制",
        "非全日制",
        "统招专升本"
      ]
    },
    {
      "key": "degree",
      "label": "学位"
    },
    {
      "key": "transcript",
      "label": "成绩单",
      "type": "attachment",
      "accept": ".pdf,.doc,.docx,.jpg,.jpeg,.png"
    },
    {
      "key": "language",
      "label": "语言能力",
      "options": [
        "英语",
        "其他",
        "无"
      ]
    },
    {
      "key": "english_level",
      "label": "英语能力",
      "options": [
        "CET-4",
        "CET-5",
        "无"
      ]
    },
    {
      "key": "other_language",
      "label": "其他语言能力"
    },
    {
      "key": "certificates",
      "label": "证书附件",
      "type": "attachment",
      "accept": ".pdf,.doc,.docx,.jpg,.jpeg,.png"
    },
    {
      "key": "age",
      "label": "年龄",
      "readonly": true,
      "virtual": true
    },
    {
      "key": "signature",
      "label": "本人签名",
      "type": "attachment",
      "accept": ".jpg,.jpeg,.png",
      "signature": true,
      "section": "补充资料"
    },
    {
      "key": "major_category",
      "label": "专业类别"
    },
    {
      "key": "resume",
      "label": "简历",
      "type": "attachment"
    },
    {
      "key": "other_major",
      "label": "其他（专业）"
    },
    {
      "key": "created_date",
      "label": "创建日期",
      "readonly": true,
      "virtual": true
    },
    {
      "key": "status",
      "label": "数据状态",
      "required": true,
      "options": [
        "草稿",
        "已生效"
      ]
    },
    {
      "key": "political_status",
      "label": "政治面貌",
      "options": [
        "群众",
        "共青团员",
        "中共预备党员",
        "中共党员"
      ]
    },
    {
      "key": "identity_card",
      "label": "身份证"
    },
    {
      "key": "health_condition",
      "label": "是否存在身体缺陷和疾病",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "language_scores",
      "label": "雅思/托福成绩"
    },
    {
      "key": "position",
      "label": "岗位",
      "section": "招聘信息",
      "options": [
        "机械工程师",
        "电气工程师",
        "安全工程师",
        "土建工程师",
        "管道工程师",
        "设备工程师",
        "数据分析师",
        "软件工程师",
        "财务专员",
        "其它"
      ]
    },
    {
      "key": "position_detail",
      "label": "其它岗位名称",
      "listHidden": true
    },
    {
      "key": "cohort",
      "label": "应届",
      "readonly": true,
      "virtual": true
    },
    {
      "key": "date",
      "label": "日期",
      "type": "date"
    },
    {
      "key": "channel",
      "label": "简历渠道",
      "options": [
        "校园线下",
        "校园平台",
        "智联招聘"
      ]
    },
    {
      "key": "is_985",
      "label": "是否985",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "is_211",
      "label": "是否211",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "is_double_first",
      "label": "是否双一流",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "is_elite",
      "label": "是否名校优生",
      "options": [
        "是",
        "否"
      ]
    },
    {
      "key": "batch",
      "label": "招聘批次",
      "hidden": true
    },
    {
      "key": "notes",
      "label": "登记备注",
      "type": "textarea",
      "hidden": true
    }
  ]
}
